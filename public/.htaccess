<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Serve a sitemap generated from currently public venue records.
  RewriteRule ^sitemap\.xml$ http://127.0.0.1:9000/api/discovery/sitemap.xml [P,L]
  RewriteRule ^about/founder/?$ index.html [L]

  # Proxy API calls to the Node backend before SPA rewrite.
  # Requires Apache mod_proxy and mod_proxy_http enabled.
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^(.*)$ http://127.0.0.1:9000/$1 [P,L]

  # Exclude API calls from SPA rewrite
  RewriteCond %{REQUEST_URI} !^/api/

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Optional: Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# Optional: Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Never cache HTML (SPA shell) so users always get the latest deploy
  ExpiresByType text/html "access plus 0 seconds"

  # Data endpoints (if any are served statically)
  ExpiresByType application/json "access plus 0 seconds"

  # Static assets (safe to cache long-term; Vite fingerprints filenames in production)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Optional: Cache-Control headers (requires mod_headers)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|ico|woff2?|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
